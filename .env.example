# ==============================================================================
# Idesignweb - Production Environment Configuration for Dokploy
# ==============================================================================

# Django Secret Key (Generate a random 50+ character string for production)
SECRET_KEY=generate-a-strong-random-secret-key-for-production

# Debug Mode (MUST be False in production)
DEBUG=False

# Allowed Hostnames (Comma-separated, e.g. yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# CSRF Trusted Origins for HTTPS Traefik reverse-proxy (Must include https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Relational Database Path (SQLite side-store for auth & sessions)
# Saved to persistent Docker volume /app/data/
DATABASE_PATH=/app/data/db.sqlite3

# MongoDB Connection Configuration
# When using docker-compose:
MONGO_URI=mongodb://mongo:27017/
# When using Dokploy Managed Database or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_DB_NAME=idesignweb_db

# Gunicorn Server Performance Tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
